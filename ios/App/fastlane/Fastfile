default_platform(:ios)

platform :ios do
  def connect_api_key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_BASE64"],
      is_key_content_base64: true,
    )
  end

  desc "One-time (or cert-rotation) bootstrap of match's encrypted certs/profiles. Run manually via workflow_dispatch."
  lane :bootstrap_match do
    match(type: "appstore", api_key: connect_api_key, readonly: false)
  end

  desc "Build a signed release IPA and upload it to TestFlight."
  lane :beta do
    match(type: "appstore", api_key: connect_api_key, readonly: true)
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj: "App.xcodeproj",
    )
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
    )
    upload_to_testflight(api_key: connect_api_key, skip_waiting_for_build_processing: true)
  end
end
